{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FPGA Proof Capsule",
  "description": "Lab session evidence bundle - deterministic replay + integrity hash",
  "type": "object",
  "required": ["session_id", "device", "created_at", "events", "signature"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^sess-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]{8}$",
      "description": "Unique session ID (format: sess-YYYY-MM-DD-random)"
    },
    "device": {
      "type": "object",
      "required": ["id", "board", "backend"],
      "properties": {
        "id": {"type": "string"},
        "board": {"type": "string"},
        "backend": {"type": "string", "enum": ["uart", "simulator", "jtag"]},
        "port": {"type": ["string", "null"]},
        "serialNumber": {"type": ["string", "null"]},
        "contract": {
          "type": "object",
          "properties": {
            "protocol": {"type": "string"},
            "format": {"type": "string"},
            "io": {"type": "object"}
          }
        }
      }
    },
    "created_at": {
      "type": "integer",
      "description": "Unix milliseconds - creation time of proof bundle"
    },
    "start_time": {
      "type": "integer",
      "description": "Unix milliseconds - first event timestamp"
    },
    "end_time": {
      "type": "integer",
      "description": "Unix milliseconds - last event timestamp"
    },
    "duration_ms": {
      "type": "integer",
      "description": "end_time - start_time"
    },
    "event_count": {
      "type": "integer",
      "description": "Total events in this session"
    },
    "events": {
      "type": "array",
      "description": "Complete event log (deterministic replay source). Must be ordered by seq field.",
      "items": {
        "type": "object",
        "required": ["type", "seq", "timestamp"],
        "properties": {
          "type": {"type": "string"},
          "seq": {"type": "integer"},
          "timestamp": {"type": "integer"}
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^hmac-sha256:[a-f0-9]{64}$",
      "description": "HMAC-SHA256(canonical_JSON(events), BRIDGE_SECRET). Non-forgeable proof of integrity."
    },
    "signature_alg": {
      "type": "string",
      "enum": ["hmac-sha256"],
      "default": "hmac-sha256",
      "description": "Algorithm used to compute signature. Bridge holds secret."
    },
    "hash": {
      "type": ["string", "null"],
      "description": "Optional: legacy SHA256 checksum (deprecated, use signature)"
    },
    "user": {
      "type": "object",
      "description": "Optional: who ran this lab",
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string"},
        "student_id": {"type": "string"}
      }
    },
    "lab_context": {
      "type": "object",
      "description": "Optional: which lab/assignment this was",
      "properties": {
        "lab_name": {"type": "string"},
        "lab_id": {"type": "string"},
        "instructor": {"type": "string"},
        "due_date": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional: arbitrary extra info",
      "additionalProperties": true
    }
  }
}
