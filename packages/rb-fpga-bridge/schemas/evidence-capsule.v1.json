{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "RedByte Evidence Capsule",
    "type": "object",
    "required": [
        "version",
        "meta",
        "design",
        "trace",
        "integrity_hash"
    ],
    "properties": {
        "version": {
            "type": "string",
            "const": "1.0.0"
        },
        "meta": {
            "type": "object",
            "required": [
                "timestamp",
                "duration_ms",
                "sample_count"
            ],
            "properties": {
                "student_id": {
                    "type": "string"
                },
                "lab_id": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "string",
                    "format": "date-time"
                },
                "duration_ms": {
                    "type": "integer"
                },
                "sample_count": {
                    "type": "integer"
                }
            }
        },
        "design": {
            "type": "object",
            "required": [
                "board_model_id",
                "wrapper_hash"
            ],
            "properties": {
                "board_model_id": {
                    "type": "string"
                },
                "wrapper_hash": {
                    "type": "string"
                },
                "pinmap_hash": {
                    "type": "string"
                },
                "bitstream_hash": {
                    "type": "string"
                }
            }
        },
        "trace": {
            "type": "object",
            "required": [
                "stats",
                "excerpt"
            ],
            "properties": {
                "stats": {
                    "type": "object",
                    "properties": {
                        "t_ms_start": {
                            "type": "integer"
                        },
                        "t_ms_end": {
                            "type": "integer"
                        }
                    }
                },
                "excerpt": {
                    "type": "array",
                    "description": "First N and Last N samples of the run",
                    "items": {
                        "type": "object"
                    }
                }
            }
        },
        "integrity_hash": {
            "type": "string",
            "description": "SHA256 signature of the capsule content (excluding this field)"
        }
    }
}