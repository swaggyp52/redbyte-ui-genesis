  "labSpec": {
    "schemaVersion": "1.0",
    "labId": "lab-8",
    "title": "Lab 8 - Security Lock FSM",
    "description": "Bridge starter checkpoints for the ECE141 security lock.\\n\\nBuild notes:\\n- Start with this Lab 8 bridge before the fuller final-project reference package.\\n- ENTER (SW5) is the shared manual clock. Keep it on the CLK pin of every DFlipFlop.\\n- RESET (SW4) clears the bridge state so you can replay 12-bit attempts cleanly.\\n- Use the scaffold to separate bit/window count, valid-group detection, milestone count, and LOCK output.\\n- LOCK (LED1) should rise only after the fourth valid 3-bit group finishes.",
    "objectives": [
      "Prove both invalid and valid serial trajectories with ENTER as the clock pulse."
    ],
    "checkpoints": [
      {
        "id": "fsm-invalid-path",
        "type": "truth-table",
        "title": "Check 1: invalid 12-bit attempt never opens LOCK",
        "description": "This proves bad 3-bit groups do not advance the lock. After every ENTER pulse in 110010010100, LOCK should stay 0.",
        "config": {
          "schedule": "clocked_macro",
          "clockSignal": "sw_enter",
          "inputs": [
            "sw_in0",
            "sw_in1",
            "sw_in2",
            "sw_reset"
          ],
          "outputs": [
            "led_lock"
          ],
