  "labSpec": {
    "schemaVersion": "1.0",
    "labId": "lab-8",
    "title": "Lab 8 - Security Lock FSM",
    "description": "Starter contract checkpoints for valid and invalid serial FSM paths.\n\nBuild notes:\n- ENTER (SW5) is the manual clock. Connect it to the CLK pin of EVERY DFlipFlop.\n- RESET (SW4) clears all state. Connect it to RST on every DFlipFlop.\n- IN0 (SW6) is the serial data bit for these checkpoints.\n- Valid 3-bit groups: 010 and 100. Four consecutive valid groups unlocks.\n- LOCK (LED1) should go high only after the 12th clock pulse of the valid sequence.",
    "objectives": [
      "Prove both invalid and valid serial trajectories with ENTER as the clock pulse."
    ],
    "checkpoints": [
      {
        "id": "fsm-invalid-path",
        "type": "truth-table",
        "title": "Invalid path proof",
        "description": "Bitstream 110010010100 on IN0 with IN2/IN1 held low must never unlock.",
        "config": {
          "schedule": "clocked_macro",
          "clockSignal": "sw_enter",
          "inputs": ["sw_in0", "sw_in1", "sw_in2", "sw_reset"],
          "outputs": ["led_lock"],
          "table": [
            { "inputs": { "sw_in0": true,  "sw_in1": false, "sw_in2": false, "sw_reset": false }, "outputs": { "led_lock": false } },
            { "inputs": { "sw_in0": true,  "sw_in1": false, "sw_in2": false, "sw_reset": false }, "outputs": { "led_lock": false } },
            { "inputs": { "sw_in0": false, "sw_in1": false, "sw_in2": false, "sw_reset": false }, "outputs": { "led_lock": false } },
            { "inputs": { "sw_in0": false, "sw_in1": false, "sw_in2": false, "sw_reset": false }, "outputs": { "led_lock": false } },
            { "inputs": { "sw_in0": true,  "sw_in1": false, "sw_in2": false, "sw_reset": false }, "outputs": { "led_lock": false } },
            { "inputs": { "sw_in0": false, "sw_in1": false, "sw_in2": false, "sw_reset": false }, "outputs": { "led_lock": false } },
