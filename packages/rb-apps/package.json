{
  "name": "@redbyte/rb-apps",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/rb-apps.js",
  "module": "./dist/rb-apps.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rb-apps.js",
      "require": "./dist/rb-apps.js"
    },
    "./stores/circuitStore": {
      "types": "./src/stores/circuitStore.ts",
      "import": "./src/stores/circuitStore.ts"
    },
    "./stores/layoutStore": {
      "types": "./src/stores/layoutStore.ts",
      "import": "./src/stores/layoutStore.ts"
    }
  },
  "scripts": {
    "build": "vite build -c ../../tools/config/vite.lib.config.ts",
    "test": "echo \"Tests run at root. This package has no direct tests.\"",
    "test:audit": "pnpm -w exec vitest run --config vitest.config.ts packages/rb-apps/src/__tests__/audit-determinism.test.ts packages/rb-apps/src/__tests__/contract-enforcement.test.tsx"
  },
  "dependencies": {
    "@redbyte/rb-board-profiles": "workspace:*",
    "@redbyte/rb-fpga-signing": "workspace:*",
    "@redbyte/rb-fpga-proof-core": "workspace:*",
    "@redbyte/rb-icons": "workspace:*",
    "@redbyte/rb-instruments": "workspace:*",
    "@redbyte/rb-lab-engine": "workspace:*",
    "@redbyte/rb-logic-3d": "workspace:*",
    "@redbyte/rb-logic-adapter": "workspace:*",
    "@redbyte/rb-logic-core": "workspace:*",
    "@redbyte/rb-logic-view": "workspace:*",
    "@redbyte/rb-protocol": "workspace:*",
    "@redbyte/rb-theme": "workspace:*",
    "@redbyte/rb-utils": "workspace:*",
    "jszip": "3.10.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@types/jszip": "3.4.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "jsdom": "27.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "vite": "^7.2.6",
    "vitest": "2.1.8"
  },
  "peerDependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}