{
    "name": "redbyte-ui-genesis",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "tools/*"
    ],
    "scripts": {
        "dev": "pnpm --filter @redbyte/playground dev",
        "dev:manual": "pnpm --filter @redbyte/manual-site dev",
        "build": "pnpm -r run build",
        "build:os": "pnpm -w build && pnpm -F redbyte-ui-genesis build",
        "build:manual": "pnpm --filter @redbyte/manual-site build",
        "build:unified": "node scripts/unified-build.mjs",
        "preview": "pnpm --filter @redbyte/playground exec vite preview --host --port 4173 --open",
        "preview:playground": "pnpm --filter @redbyte/playground exec vite preview --host --port 4173 --open",
        "preview:manual": "pnpm --filter @redbyte/manual-site exec vite preview --host --port 4174 --open",
        "e2e:build": "pnpm build",
        "e2e:serve": "pnpm --filter @redbyte/playground exec vite preview --host 127.0.0.1 --port 4173 --strictPort",
        "e2e:test": "pnpm exec playwright test",
        "e2e:test:dev": "pnpm exec playwright test --config playwright.dev.config.ts",
        "e2e:smoke:ce": "pnpm run e2e:build && pnpm run e2e:test --project=chromium --grep 'CE|ISSUE-'",
        "lint": "pnpm -r --if-present run lint",
        "lint:selectors": "node ./scripts/lint-zustand-selectors.js",
        "typecheck": "pnpm -r --if-present run typecheck",
        "test:ci": "pnpm run test:audit",
        "test:audit": "pnpm -w exec vitest run packages/rb-logic-3d/src/lab-model/__tests__/fuzz.test.ts packages/rb-logic-3d/src/lab-model/__tests__/netlist.test.ts packages/rb-logic-3d/src/lab-model/__tests__/probe-samples.test.ts packages/rb-shell/src/__tests__/window-snap-preview.test.tsx packages/rb-primitives/src/__tests__/toast-dismiss.test.tsx packages/rb-apps/src/__tests__/instrument-dock.test.tsx",
        "ci:gate": "pnpm -w install --frozen-lockfile && pnpm -w build && pnpm test:audit",
        "test": "vitest run",
        "quality": "node -e \"console.log('E2E: SKIPPED (run pnpm quality:full to include Playwright)')\" && pnpm run build && pnpm run test:ci && pnpm run lint",
        "quality:full": "node -e \"console.log('E2E: ENABLED (Playwright smoke tests blocking)')\" && pnpm run build && pnpm run test:ci && pnpm run test:smoke:ci && pnpm run lint",
        "quality:smoke": "pnpm -r run build && pnpm --dir apps/manual-site run sanity && node ./scripts/test-mvp.js",
        "test:smoke": "playwright test",
        "test:smoke:ci": "pnpm run e2e:build && playwright test tests/e2e/smoke.spec.ts",
        "test:smoke:ce": "playwright test tests/e2e/view-window-matrix.spec.ts",
        "test:mvp": "node ./scripts/test-mvp.js",
        "test:proof": "node ./scripts/test-proof.js",
        "playwright:install": "playwright install chromium",
        "format": "pnpm -r --if-present run format",
        "a11y": "pnpm -r --if-present run test:a11y",
        "perf": "pnpm -r --if-present run test:perf",
        "coverage": "vitest run --coverage --passWithNoTests",
        "capture:screenshots": "tsx scripts/capture-screenshots.ts",
        "perf:soak": "tsx scripts/perf-soak.ts",
        "ship:gate": "tsx scripts/ship-gate.ts",
        "release:gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
        "agent:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agent-status.ps1",
        "agent:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agent-verify.ps1",
        "agent:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agent-plan.ps1",
        "agent:lab": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agent-lab.ps1",
        "ops:server": "node api/server.mjs",
        "ops:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-smoke.ps1",
        "ops:make-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-make-bundle.ps1",
        "ops:ingest-test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-ingest-test.ps1",
        "ops:student-export-fixture-test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-student-export-fixture-test.ps1",
        "ops:liveness": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-liveness.ps1 -StartServer -JsonOut .\\ops-liveness.json",
        "ops:liveness:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-liveness.ps1 -StartServer -ZipPath .\\packages\\ops\\labs\\fixtures\\test-submission.rb-lab.zip -JsonOut .\\ops-liveness.json",
        "ops:liveness:pass": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-liveness.ps1 -StartServer -ZipPath .\\packages\\ops\\labs\\fixtures\\test-submission.pass.rb-lab.zip -ExpectExitCodes 0 -JsonOut .\\ops-liveness.json",
        "ops:liveness:fail": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-liveness.ps1 -StartServer -ZipPath .\\packages\\ops\\labs\\fixtures\\test-submission.rb-lab.zip -ExpectExitCodes 1 -JsonOut .\\ops-liveness.json",
        "ops:liveness:ci": "pnpm ops:liveness:pass && pnpm ops:liveness:fail",
        "ops:student-export:pass": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-liveness.ps1 -StartServer -ZipPath .\\packages\\ops\\labs\\fixtures\\student-export-pass.rb-lab.zip -ExpectExitCodes 0 -JsonOut .\\ops-liveness.json",
        "ops:student-export:fail": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-liveness.ps1 -StartServer -ZipPath .\\packages\\ops\\labs\\fixtures\\student-export-fail.rb-lab.zip -ExpectExitCodes 1 -JsonOut .\\ops-liveness.json",
        "ops:student-export:ci": "pnpm ops:student-export:pass && pnpm ops:student-export:fail",
        "ops:diff-gate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ops-diff-test.ps1",
        "sim:repeatability-gate": "pnpm exec vitest run packages/rb-logic-core/src/__tests__/sim-repeatability-gate.test.ts",
        "sim:loop-detection-gate": "pnpm exec vitest run packages/rb-logic-core/src/__tests__/sim-loop-detection-gate.test.ts",
        "sim:probe-stability-gate": "pnpm exec vitest run packages/rb-logic-core/src/__tests__/sim-probe-stability-gate.test.ts",
        "bridge:dryrun-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/bridge-dryrun-gate.test.ts",
        "hw:mode-fallback-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/hw-mode-fallback-gate.test.ts",
        "net:highlight-resolution-gate": "pnpm exec vitest run packages/rb-logic-view/src/__tests__/net-highlight-resolution-gate.test.ts",
        "p1c:build": "pnpm -s e2e:build",
        "p1c:boot-gate": "pnpm -s e2e:test tests/e2e/p1c-boot-gate.spec.ts",
        "p1c:render-storm-baseline": "pnpm -s e2e:test tests/e2e/p1c-render-storm-baseline.spec.ts",
        "rbproj:roundtrip-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/rbproject-roundtrip-gate.test.ts",
        "rbproj:roundtrip-gate:update": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:UPDATE_RBPROJ_GOLDEN='1'; pnpm -s rbproj:roundtrip-gate\"",
        "rbx:evidence-determinism-gate": "pnpm exec vitest run packages/rb-lab-engine/src/services/__tests__/rbx-evidence-determinism-gate.test.ts",
        "rbx:evidence-determinism-gate:update": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:UPDATE_RBX_EVIDENCE_GOLDEN='1'; pnpm -s rbx:evidence-determinism-gate\"",
        "proj:autosave-recovery-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/proj-autosave-recovery-gate.test.ts",
        "proj:recovery-priority-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/proj-recovery-priority-gate.test.ts",
        "proj:undo-redo-gate": "pnpm exec vitest run packages/rb-lab-engine/src/__tests__/proj-undo-redo-gate.test.ts",
        "os:window-raise-gate": "pnpm exec vitest run packages/rb-windowing/src/__tests__/window-raise-gate.test.ts",
        "os:error-boundary-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/error-boundary-gate.test.tsx",
        "os:performance-mode-gate": "pnpm exec vitest run packages/rb-utils/src/__tests__/performance-mode-gate.test.ts",
        "os:instrument-hz-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/instrument-hz-gate.test.ts",
        "lab:workflow-export-verify-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/lab-workflow-export-verify-gate.test.ts",
        "lab:probe-sampling-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/lab-probe-sampling-gate.test.ts",
        "hw:dryrun-program-flow-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/hw-dryrun-program-flow-gate.test.ts",
        "ui:progress-contract-gate": "pnpm exec vitest run packages/rb-utils/src/__tests__/progress-contract-gate.test.ts",
        "ui:help-topics-contract-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/ui-help-topics-contract-gate.test.ts",
        "ui:help-entrypoints-gate": "pnpm exec vitest run packages/rb-apps/src/__tests__/ui-help-entrypoints-gate.test.ts",
        "ui:style-token-contract-gate": "pnpm exec vitest run packages/rb-shell/src/__tests__/ui-style-token-contract-gate.test.ts",
        "ui:dev-guards-contract-gate": "pnpm exec vitest run packages/rb-utils/src/__tests__/ui-dev-guards-contract-gate.test.ts",
        "ui:license-audit-gate": "pnpm exec vitest run packages/rb-shell/src/__tests__/ui-license-audit-gate.test.ts",
        "gen-license-snapshot": "node scripts/gen-license-snapshot.mjs",
        "verify:all": "pnpm -s verify:gates",
        "verify:gates": "pnpm -r build && pnpm -s sim:repeatability-gate && pnpm -s sim:loop-detection-gate && pnpm -s sim:probe-stability-gate && pnpm -s rbproj:roundtrip-gate && pnpm -s rbx:evidence-determinism-gate && pnpm -s lab:workflow-export-verify-gate && pnpm -s lab:probe-sampling-gate && pnpm -s hw:dryrun-program-flow-gate && pnpm -s proj:recovery-priority-gate && pnpm -s ui:help-topics-contract-gate && pnpm -s ui:help-entrypoints-gate && pnpm -s ui:style-token-contract-gate && pnpm -s ui:dev-guards-contract-gate && pnpm -s ui:license-audit-gate",
        "verify:gates:full": "pnpm -s verify:gates && pnpm -s ops:diff-gate && pnpm -s ops:student-export-fixture-test",
        "ci:parity": "pnpm install --frozen-lockfile && pnpm verify:all",
        "ci:parity:pages": "pnpm -r build",
        "bless:artifacts": "node ./scripts/bless-latest-artifacts.js",
        "verify:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-install.ps1",
        "bridge:smoke": "node tools/bridge-smoke.mjs",
        "bridge:smoke:mock": "node tools/bridge-smoke.mjs --mock",
        "bridge:dev": "pnpm --filter @redbyte/rb-bridge-agent dev"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.0",
        "@testing-library/jest-dom": "6.6.3",
        "@testing-library/react": "16.1.0",
        "@testing-library/user-event": "14.6.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "5.1.1",
        "@vitest/coverage-v8": "2.1.8",
        "@welldone-software/why-did-you-render": "8.0.3",
        "archiver": "7.0.1",
        "autoprefixer": "10.4.22",
        "cross-env": "7.0.3",
        "eslint-plugin-jsx-a11y": "workspace:*",
        "jsdom": "27.2.0",
        "playwright": "1.58.1",
        "postcss": "8.5.6",
        "rimraf": "6.1.2",
        "tailwindcss": "3.4.18",
        "vite": "7.2.6",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "5.1.4",
        "vitest": "2.1.8",
        "ws": "^8.19.0"
    },
    "dependencies": {
        "@serialport/parser-readline": "12.0.0",
        "immer": "^11.1.3",
        "zustand": "5.0.9"
    },
    "engines": {
        "node": ">=20.19.0",
        "pnpm": ">=10.24.0"
    },
    "pnpm": {
        "overrides": {
            "react": "19.2.1",
            "react-dom": "19.2.1"
        }
    },
    "packageManager": "pnpm@10.24.0"
}
