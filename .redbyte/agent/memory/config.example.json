{
  "_comment": "Copy to config.json for local overrides. Keep paths relative when possible; config.json is gitignored.",
  "obsidianVaultPath": ".",
  "repoRoot": ".",
  "includeVaultGlobs": [
    "01 Dashboard/**/*.md",
    "03 Architecture/**/*.md",
    "04 Decisions/**/*.md",
    "05 Bugs/**/*.md",
    "08 Agents + Prompts/**/*.md",
    "00 Inbox/**/*.md",
    "business/**/*.md"
  ],
  "excludeVaultGlobs": [
    ".obsidian/**",
    "**/.trash/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ],
  "includeRepoDocs": [
    "AI_STATE.md",
    "docs/ACTIVE_WORK.md",
    "docs/product/RED_BYTE_CURRENT_TRUTH.md",
    "docs/product/RED_BYTE_AGENT_OPERATING_RULES.md",
    "docs/product/RED_BYTE_WORK_QUEUE.md",
    "docs/product/RED_BYTE_OBSIDIAN_SYNC_RULES.md",
    "docs/product/RED_BYTE_LOCAL_AGENT_LAB.md",
    "docs/product/RED_BYTE_AGENT_CAPABILITY_MODEL.md",
    "docs/product/RED_BYTE_OLLAMA_LOCAL_SETUP.md",
    "docs/product/RED_BYTE_OBSIDIAN_MEMORY_BRIDGE.md",
    "docs/product/RED_BYTE_PRODUCT_TRACEABILITY_MODEL.md",
    "docs/product/V1_RELEASE_SPEC.md",
    "docs/product/V1_RELEASE_READINESS_CHECKLIST.md",
    "docs/product/RED_BYTE_STUDIO_PRODUCT_BRIEF.md",
    "docs/contracts/RedByte_Product_Contract.md",
    "docs/manuals/RedByte_Product_Manual.md",
    "docs/roadmap/RedByte_Gap_Audit.md",
    "docs/IDE_SYSTEM_MAP.md",
    "docs/IDE_PRODUCT_DEBT_REGISTER.md",
    "docs/RED_BYTE_IDE_PRODUCT_FLOW_MODEL.md",
    "docs/ide/00-ide-layout.md",
    "docs/ide/01-project.md",
    "docs/ide/02-design.md",
    "docs/ide/03-verify.md",
    "docs/ide/04-export.md",
    "docs/ide/05-import.md",
    "docs/ide/SURFACE_CONFORMANCE.md",
    "docs/release/manual-assignment-qa-script.md",
    "docs/release/v1-release-checklist.md",
    "docs/release/product-hardening-ticket-template.md",
    "docs/rehearsal/failure-ticket-template.md",
    "docs/DOC_INDEX.md",
    ".redbyte/work/NEXT_WORK_PACKET.md"
  ],
  "excludeRepoGlobs": [
    ".git/**",
    ".redbyte/agent/memory/index/**",
    ".redbyte/agent/memory/runs/**",
    ".redbyte/agent/runs/**",
    ".redbyte/agent/memory/config.json",
    "node_modules/**",
    "dist/**",
    "dist.staged/**",
    "build/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "out/**",
    "artifacts/**",
    "trace/**"
  ],
  "embeddingModel": "all-minilm",
  "chatModel": "auto",
  "maxFileBytes": 262144,
  "maxChunkChars": 2400,
  "maxChunksPerSource": 80,
  "indexOutputDir": ".redbyte/agent/memory/index",
  "allowVaultWrites": false,
  "productTruthPriority": [
    "current_truth",
    "target_contract",
    "surface_spec",
    "memory",
    "historical",
    "unknown"
  ],
  "traceabilityRequired": true
}
