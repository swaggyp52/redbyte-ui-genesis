-}
+  if (pin.startsWith('LD')) {
+    const index = Number.parseInt(pin.slice(2), 10);
+    return Number.isFinite(index) && index >= 0 && index < BASYS3_LED_PINS.length
+      ? BASYS3_LED_PINS[index]
+      : null;
+  }
+  if (pin === 'CLK100MHZ') {
+    return BASYS3_CLOCK_PIN;
+  }
+  return null;
+}
 
