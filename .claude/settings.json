{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/rb-hooks/session-start.mjs",
            "timeout": 10,
            "statusMessage": "Loading RedByte session brief..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/rb-hooks/stop-reminder.mjs",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/rb-hooks/post-edit-validate.mjs",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
