  "hdl": {
    "top": "student_top",
    "sources": [
      {
        "path": "rtl/student_top.vhd",
        "language": "vhdl",
        "text": "-- ORIGINAL student top\nlibrary ieee; use ieee.std_logic_1164.all;\nentity student_top is port(A,B: in std_logic; Y: out std_logic); end;\narchitecture rtl of student_top is begin Y <= A and B; end;\n"
      },
      {
        "path": "rtl/student_helper.v",
        "language": "verilog",
        "text": "// ORIGINAL helper retained as a read-only source\nmodule student_helper(input a, input b, output y); assign y = a & b; endmodule\n"
      },
      {
        "path": "constraints/original-A.xdc",
        "language": "xdc",
        "text": "# ORIGINAL A\nset_property PACKAGE_PIN V17 [get_ports A]\n"
      },
      {
        "path": "constraints/original-B.xdc",
        "language": "xdc",
        "text": "# ORIGINAL B\nset_property PACKAGE_PIN V16 [get_ports A]\n"
      }
    ]
  }
